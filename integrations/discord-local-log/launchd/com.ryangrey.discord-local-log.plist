<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ryangrey.discord-local-log</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ryangrey/.local/discord-mcp/.venv/bin/python</string>
        <string>/Users/ryangrey/Developer/scrambled-raid-bot/integrations/discord-local-log/ingest.py</string>
    </array>
    <!-- Run whenever the plugin appends to the events file... -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/ryangrey/Library/Application Support/discord-local-log/events.jsonl</string>
    </array>
    <!-- ...and every five minutes regardless, in case a watch is missed. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <!-- Coalesce bursts: launchd will not start a second run inside 10s. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/ryangrey/Library/Application Support/discord-local-log/ingest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ryangrey/Library/Application Support/discord-local-log/ingest.log</string>
</dict>
</plist>
