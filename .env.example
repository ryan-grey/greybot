# Copy to .env and fill in. .env is gitignored.
# Only DEPLOY-TIME values live here. Runtime secrets live in SSM Parameter Store
# (see infra/iam-setup.sh) and are never written into the Lambda's environment.
ACCOUNT_ID=123456789012
REGION=us-east-1

# --- guild identity (not secret; shipped as Lambda env vars) ---
GUILD_NAME=Scrambled
GUILD_REALM=                # Raider.IO/WCL realm slug, lowercase-hyphenated e.g. area-52
GUILD_REGION=us             # us | eu | kr | tw

# --- Discord ---
PROG_RAIDER_ROLE_ID=        # right-click the Prog Raiders role -> Copy Role ID (needs Developer Mode)
ANNOUNCE_TZ=America/New_York # timezone used to render the AOTC date/time

# The #bots webhook URL is a SECRET and is NOT set here. Put it in SSM:
#   /scrambled/discord/webhook_url
# Likewise the Warcraft Logs OAuth client:
#   /scrambled/wcl/client_id
#   /scrambled/wcl/client_secret
