# Copy to .env and fill in. .env is gitignored.
#
# DEPLOY-TIME values only. Everything the bot needs at runtime -- guild name, realm,
# region, the Prog Raiders role id, the Discord webhook and the Warcraft Logs client --
# lives in SSM Parameter Store under /greybot and is read at runtime. Nothing here can
# disagree with what the bot is actually using, because none of it is that.
ACCOUNT_ID=123456789012
REGION=us-east-1

# Resource names. Defaults match infra/iam-setup.sh; override only if you renamed them.
FUNCTION_NAME=ryangrey-greybot
ROLE_NAME=ryangrey-greybot-role
STATE_TABLE=ryangrey-greybot
SCHEDULE_NAME=ryangrey-greybot-poll

# Timezone the AOTC date/time is rendered in.
ANNOUNCE_TZ=America/New_York

# scripts/set-webhook-identity.py reads the webhook from /greybot/discord/webhook_url.
# To point it somewhere else for one shell, export DISCORD_WEBHOOK_URL instead.
