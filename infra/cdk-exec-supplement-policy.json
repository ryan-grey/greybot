{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApiGatewayManagement",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE",
        "apigateway:TagResource",
        "apigateway:UntagResource"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis",
        "arn:aws:apigateway:us-east-1::/apis/*",
        "arn:aws:apigateway:us-east-1::/tags/*"
      ]
    },
    {
      "Sid": "ManageGreybotRoleInlinePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::164106395035:role/ryangrey-greybot-role",
        "arn:aws:iam::164106395035:role/ryangrey-greybot-role-dev",
        "arn:aws:iam::164106395035:role/ryangrey-greybot-scheduler-role",
        "arn:aws:iam::164106395035:role/ryangrey-greybot-scheduler-role-dev"
      ]
    },
    {
      "Sid": "CreateGreybotResourcesDevOpsLacks",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "dynamodb:UpdateTable"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:164106395035:log-group:/aws/lambda/ryangrey-greybot*",
        "arn:aws:scheduler:us-east-1:164106395035:schedule/*/ryangrey-greybot*",
        "arn:aws:dynamodb:us-east-1:164106395035:table/ryangrey-greybot*"
      ]
    },
    {
      "Sid": "DestructiveOnDevResourcesOnly",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogGroup",
        "scheduler:DeleteSchedule",
        "dynamodb:DeleteTable"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:164106395035:log-group:/aws/lambda/ryangrey-greybot-dev*",
        "arn:aws:scheduler:us-east-1:164106395035:schedule/*/ryangrey-greybot-poll-dev",
        "arn:aws:dynamodb:us-east-1:164106395035:table/ryangrey-greybot-dev"
      ]
    },
    {
      "Sid": "ReadCdkAssetBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-164106395035-us-east-1/*"
    },
    {
      "Sid": "ReadBootstrapVersion",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1:164106395035:parameter/cdk-bootstrap/*"
    },
    {
      "Sid": "TaggingCloudFormationPerformsOnImport",
      "Effect": "Allow",
      "Action": [
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:ListTagsOfResource",
        "scheduler:TagResource",
        "scheduler:UntagResource",
        "scheduler:ListTagsForResource",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "*"
    }
  ]
}
